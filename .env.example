# WeatherIQ environment configuration
# Copy to .env.local and fill in values. NEVER commit .env.local.

# ----------------------------------------------------------------------------
# Public site URL (used for metadata/canonical URLs)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Weather provider (Open-Meteo)
# ----------------------------------------------------------------------------
# Open-Meteo is free and requires NO API key for forecast + geocoding.
# Nothing to configure. Set this only if you self-host or use a commercial
# Open-Meteo plan with an API key (then also update src/config/env.ts).
# OPEN_METEO_API_KEY=

# ----------------------------------------------------------------------------
# Cesium Ion token — ONLY needed when the 3D globe (Phase 4) is enabled.
# Server-side token: never expose to the browser. Rotate the token that was
# previously committed to this repository before enabling the globe.
# CESIUM_TOKEN=

# ----------------------------------------------------------------------------
# Future phases (leave empty until implemented):
#   DATABASE_URL=        (PostgreSQL + Drizzle, Phase 5+)
#   REDIS_URL=           (shared cache, Phase 5+)
#   AUTH_SECRET=         (Auth.js, Phase 5+)
#   AI_API_KEY=          (AI assistant, Phase 7+)
#   SENTRY_DSN=          (observability, Phase 9+)
# ----------------------------------------------------------------------------
